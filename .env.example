# ZeKo Code — biến môi trường (copy thành .env rồi sửa)
# Mỗi biến *_API_KEYS nhận nhiều key, phân cách bằng dấu phẩy → app tự roll vòng.

PORT=8787
HOST=0.0.0.0

# GLM 5.3 (bản thường — "deep") qua OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=z-ai/glm-5.3,z-ai/glm-5.3:free,z-ai/glm-4.6
OPENROUTER_API_KEYS=sk-or-v1-xxx,sk-or-v1-yyy

# GLM 5.3 Flash qua TokenRouter
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_MODELS=z-ai/glm-5.3-flash,z-ai/glm-5.3-free,z-ai/glm-5.3
TOKENROUTER_API_KEYS=sk-xxx,sk-yyy
